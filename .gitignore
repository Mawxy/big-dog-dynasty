sleeper_data/
sleeper_data_pizza/
__pycache__/
node_modules/
dist/
nfl_history_data/
HANDOFF.md
vite.config.*.timestamp-*.mjs
# Claude Code local tooling (dev-server preview config) — machine-local, never shipped
.claude/
# raw trade corpus can be tens of MB at scale — kept as a CI artifact, not committed
data/trade_corpus.json
data/trade_corpus_*.json
# per-roster outcome rows: ~200 MB at full crawl scale. The committed file is
# data/outcome_signals_<shard>.json, which is the aggregate of these.
data/outcome_corpus.json
data/outcome_corpus_*.json
data/leagues/*/blended_values.json
data/leagues/*/cvi_detail.json

# crawler state — progress/contrib/seen_drafts/seen_leagues + the rookie corpus
# accumulator. Persisted between CI runs by actions/cache, never by git; grows
# to a row per draft across every crawled league chain.
.crawl-state/

# scratch/ — throwaway local artifacts: design previews, one-off reports,
# screenshots, anything generated to look at rather than to ship. Never committed.
scratch/
# same, if one lands outside scratch/ by accident
*-preview.html
HANDOFF_*.md
